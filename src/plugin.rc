#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION YP_VERSION_NUMBERS
 PRODUCTVERSION YP_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "YAML and Properties converter for Notepad++\0"
            VALUE "FileVersion", YP_VERSION_STRING "\0"
            VALUE "InternalName", "YamlProperties\0"
            VALUE "OriginalFilename", "YamlProperties.dll\0"
            VALUE "ProductName", "YamlProperties\0"
            VALUE "ProductVersion", YP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
